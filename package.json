{
  "name": "studio-pm",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "db:migrate:milestones": "npm run db:migrate:milestones --prefix backend",
    "db:clone-to-dev": "bash scripts/clone-db-to-dev.sh",
    "dev:web": "npm run dev --prefix frontend",
    "dev:api": "npm start --prefix backend",
    "dev:api:3110": "npm run start:3110 --prefix backend",
    "format": "prettier --write \"frontend/**/*.{js,jsx,json,css,md}\" \"backend/**/*.{js,json,md}\"",
    "format:check": "prettier --check \"frontend/**/*.{js,jsx,json,css,md}\" \"backend/**/*.{js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
