# Database
DB_NAME=studio_pm
# 開發用複製庫（backend-dev）；複製指令見 scripts/clone-db-to-dev.sh
DB_DEV_NAME=studio_pm_dev
DB_USER=studio
DB_PASSWORD=changeme_in_production
# 本機後端連 Docker Postgres：先 docker compose up -d postgres
# DB_HOST=localhost  DB_PORT=5432（compose 會對外對映；若本機已有 PostgreSQL 占用 5432，改設 POSTGRES_PUBLISH_PORT=5433 並 DB_PORT=5433）

# App
PORT=80
# docker compose --profile dev 的 frontend-dev：請指向 nginx 的 **dev API** 路徑 /api-dev（連 studio_pm_dev）
# 從內網其他電腦開 http://<VM-IP>:3000 時必填完整網址，否則會連錯主機。
# 範例（請改成你的 VM 區網 IP）：
# DEV_NEXT_PUBLIC_API_URL=http://192.168.1.50/api-dev
# 瀏覽器只在 VM 本機開發可用：
# DEV_NEXT_PUBLIC_API_URL=http://127.0.0.1/api-dev
# API（瀏覽器看到的基底網址）
# ─ Docker + nginx（推薦）：同源 `/api`，由 nginx 轉到 backend。
NEXT_PUBLIC_API_URL=/api
# ─ 本機只跑 npm、不用 nginx：`next dev` 會自動改連 127.0.0.1:下方埠（見 frontend/.env.development）。
#   請勿再用 http://localhost/api（那是 80 埠，不是 Next）。
API_PROXY_TARGET=http://127.0.0.1:3001
NEXT_PUBLIC_API_BACKEND_PORT=3001

# 埠與 NAS / Nextcloud 衝突時（例如 3001 已被占用）：
# 1) 在 frontend 複製 frontend/.env.development.local.example → frontend/.env.development.local
#    （預設範例為 3110；勿用 3006–3105，Windows/Hyper-V 常排除該區間會 EACCES）
# 2) 從 repo 根目錄執行：npm run dev:api:3110  （或 backend/.env 設定 PORT=你想的埠後照常 npm run dev:api）
# 前後端埠號必須一致；改完前端 .local 後請重啟 next dev。

# 從 repo 根目錄快捷鍵（不必 cd 進子資料夾）：
#   npm run install:all
#   npm run dev:api        → 後端 :3001（或 backend/.env 的 PORT）
#   npm run dev:api:3110   → 後端固定 :3110（避開 3001 占用，且避開 Windows 常態排除的 3006–3105）
#   npm run dev:web        → 前端固定 :3000（請先關掉占用 3000 的程式）

# File uploads (TrueNAS path mapping)
# UPLOAD_DIR=/mnt/data/studio-pm/uploads
